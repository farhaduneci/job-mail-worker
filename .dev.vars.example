# All optional. Leave empty to turn the feature off.
# Telegram bot token from @BotFather, for pings and the weekly digest.
TELEGRAM_BOT_TOKEN=
# Chat that receives them (message the bot, then read chat.id from https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_CHAT_ID=
# TypeSafe API key (https://typesafe.ai). Sharper classifier with probabilities; Workers AI is used without it.
TYPESAFE_API_KEY=
